<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>netstandard2.0</TargetFrameworks>
      <RootNamespace>Mod</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModClrExUnsafe\ModClrExUnsafe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PointerDelegate">
      <HintPath>..\ModClrExUnsafe\PointerDelegate.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Unity-side providers (Unity/ folder) are source files meant to be copied into a
         Unity project; they reference UnityEngine/UnityEditor and must not compile into
         this netstandard library. -->
    <Compile Remove="Unity\**\*.cs" />
  </ItemGroup>

</Project>
