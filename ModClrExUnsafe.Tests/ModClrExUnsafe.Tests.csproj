<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Auto-loads the repo-root .runsettings for every `dotnet test` run (session
         timeout etc.) without needing the CLI settings flag. Official mechanism:
         dotnet SDK Microsoft.TestPlatform.targets maps VSTestSetting to
         $(RunSettingsFilePath) when no settings file is passed on the command line. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModClrExUnsafe\ModClrExUnsafe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PointerDelegate">
      <HintPath>..\ModClrExUnsafe\PointerDelegate.dll</HintPath>
    </Reference>
    <!-- ByRefUtils（RawRef/Ref）是普通 dll 引用，不经 ProjectReference 传递——Tests 直引 -->
    <Reference Include="ByRefUtils">
      <HintPath>..\ModClrExUnsafe\ByRefUtils.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>