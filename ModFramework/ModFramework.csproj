<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <InvariantGlobalization>true</InvariantGlobalization>

    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <!-- 为 .NET Framework 禁用 AOT -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
        <PublishAot>false</PublishAot>
    </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ModClrEx\ModClrEx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ByRefUtils">
      <HintPath>..\ModClrExUnsafe\ByRefUtils.dll</HintPath>
    </Reference>
    <Reference Include="ByRefUtils.TrackingRef">
      <HintPath>..\ModClrExUnsafe\ByRefUtils.TrackingRef.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
